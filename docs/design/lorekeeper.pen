                          "fill": "$color-surface-default",
                          "justifyContent": "center",
                          "children": [
                            {
                              "type": "frame",
                              "id": "i5iPDk",
                              "name": "Manuscript Reading Column",
                              "width": 720,
                              "height": "fill_container",
                              "layout": "vertical",
                              "gap": "$space-6",
                              "padding": [
                                52,
                                0,
                                40,
                                0
