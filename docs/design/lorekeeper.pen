                          "fill": "$b:color-text-primary",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 190,
                          "content": "아르카디아는 마법과 증기 기술이 함께 발전한 대륙이다. 도시마다 기억을 연료로 다루는 방식이 달라 서로 다른 문화와 법이 형성되었다.\n\n대륙 중앙의 유리 산맥은 모든 마나 흐름의 시작점으로 여겨진다.",
                          "lineHeight": "$b:line-height-body",
                          "fontFamily": "$b:font-family-ui",
                          "fontSize": "$b:font-size-manuscript-body",
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
