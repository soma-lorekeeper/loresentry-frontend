{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWebBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::loresentry-web-prod-197179613039"
    },
    {
      "Sid": "SyncWebObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::loresentry-web-prod-197179613039/*"
    },
    {
      "Sid": "InvalidateCdnCache",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::197179613039:distribution/E3L6QXQGVEJTYQ"
    }
  ]
}
