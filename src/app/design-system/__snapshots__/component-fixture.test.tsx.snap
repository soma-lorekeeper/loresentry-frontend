exports[`ComponentFixture (dark) > renders every common UI state in the dark theme 1`] = `"dark:<div class="_stack_2684fe" data-gap="6"><section aria-labelledby="controls-heading" class="_fixtureSection_b981aa"><h2 id="controls-heading">버튼과 상태</h2><p class="_fixtureLegend_b981aa">Tab으로 포커스를 이동해 focus 상태를 확인합니다.</p><div class="_inline_2684fe _fixtureRow_b981aa" data-gap="2"><button class="_button_2684fe" data-variant="secondary" type="button"><span aria-hidden="true" class="_buttonIcon_2684fe">✦</span><span>AI 챗</span></button><button class="_button_2684fe" data-variant="primary" type="button"><span>저장</span></button><button class="_button_2684fe" data-variant="ghost" type="button"><span>취소</span></button><button aria-busy="true" class="_button_2684fe" data-variant="secondary" disabled="" type="button"><span aria-hidden="true" class="_spinner_2684fe"></span><span>저장 중</span></button><button class="_button_2684fe" data-variant="secondary" disabled="" type="button"><span>사용 불가</span></button><button aria-label="새 항목 추가" class="_iconButton_2684fe" type="button">＋</button><button aria-busy="true" aria-label="항목 추가 중" class="_iconButton_2684fe" disabled="" type="button"><span aria-hidden="true" class="_spinner_2684fe"></span></button><div class="_menuRoot_2684fe" data-placement="end"><button aria-expanded="false" aria-haspopup="menu" aria-label="프로젝트 선택" class="_button_2684fe" type="button">프로젝트 선택</button></div></div><p class="_fixtureLegend_b981aa">메뉴에서 위·아래 방향키, Home, End와 Escape를 확인합니다.</p></section><section aria-labelledby="fields-heading" class="_fixtureSection_b981aa"><h2 id="fields-heading">입력과 안내</h2><div class="_fixtureGrid_b981aa"><div class="_surface_2684fe" data-elevation="default"><div class="_field_2684fe"><div class="_labelRow_2684fe"><label for="fixture-project-name">프로젝트 이름</label><span class="_required_2684fe">필수</span></div><input aria-describedby="fixture-project-name-description" class="_input_2684fe" id="fixture-project-name" required="" value="유리 정원의 기록"><p class="_fieldMessage_2684fe" id="fixture-project-name-description">사이드바와 프로젝트 목록에 표시되는 이름입니다.</p></div></div><div class="_surface_2684fe" data-elevation="default"><div class="_field_2684fe"><div class="_labelRow_2684fe"><label for="fixture-project-error">프로젝트 이름</label><span class="_required_2684fe">필수</span></div><input aria-describedby="fixture-project-error-error" aria-invalid="true" class="_input_2684fe" id="fixture-project-error" required=""><p class="_fieldError_2684fe" id="fixture-project-error-error">프로젝트 이름을 입력해 주세요.</p></div></div><div class="_surface_2684fe" data-elevation="default"><div class="_field_2684fe"><div class="_labelRow_2684fe"><label for="fixture-project-disabled">비활성 입력</label></div><input disabled="" class="_input_2684fe" id="fixture-project-disabled" value="편집할 수 없는 값"></div></div><div aria-live="polite" class="_notice_2684fe" data-variant="info" role="status"><span aria-hidden="true" class="_noticeIcon_2684fe">i</span><span>Google 로그인이 취소됐어요.</span></div><div aria-live="assertive" class="_notice_2684fe" data-variant="error" role="alert"><span aria-hidden="true" class="_noticeIcon_2684fe">!</span><span>저장하지 못했어요. 다시 시도해 주세요.</span></div><div aria-live="polite" class="_notice_2684fe" data-variant="success" role="status"><span aria-hidden="true" class="_noticeIcon_2684fe">i</span><span>저장했어요.</span></div></div></section><section aria-labelledby="layout-heading" class="_fixtureSection_b981aa"><h2 id="layout-heading">레이아웃 primitive</h2><div class="_fixtureGrid_b981aa"><div class="_surface_2684fe" data-elevation="default">기본 Surface</div><div class="_surface_2684fe" data-elevation="raised">Raised Surface</div></div></section><section aria-labelledby="dialog-heading" class="_fixtureSection_b981aa"><h2 id="dialog-heading">대화상자</h2><p class="_fixtureLegend_b981aa">열기 후 Tab·Shift+Tab 순환과 Escape 포커스 복귀를 확인합니다.</p><button class="_button_2684fe" data-variant="secondary" type="button"><span>삭제 대화상자 열기</span></button><dialog aria-describedby="generated-id" aria-labelledby="generated-id" aria-modal="true" class="_dialog_2684fe"><div class="_dialogHeader_2684fe"><div><h2 class="_dialogTitle_2684fe" id="generated-id">영구 삭제할까요?</h2><p class="_dialogDescription_2684fe" id="generated-id">이 항목은 프로젝트에서 완전히 삭제되며 복원할 수 없습니다.</p></div></div><div class="_surface_2684fe" data-elevation="default">12화 · 균열의 밤</div><div class="_dialogActions_2684fe"><button class="_button_2684fe" data-variant="secondary" type="button"><span>취소</span></button><button class="_button_2684fe" data-variant="primary" type="button"><span>영구 삭제</span></button></div></dialog></section></div>"`;

